{
  "name": "\u8ba2\u5355\u53d1\u8d27\u540c\u6b65 Google Sheets",
  "description": "\u5f53\u8ba2\u5355\u72b6\u6001\u53d8\u66f4\u4e3a\u5df2\u53d1\u8d27\u65f6\uff0c\u81ea\u52a8\u540c\u6b65\u5230 Google Sheets \u5f52\u6863",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"order_status\") != null) and (.trigger.data.order_status == \"shipped\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "google_sheets",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncOrderToGoogleSheets",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncOrderToGoogleSheets"
  }
}